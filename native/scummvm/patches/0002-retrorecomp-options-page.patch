+#if !SDL_VERSION_ATLEAST(3, 0, 0)
+// Retro-Recomp's scanlines (the host kit's presentation mask, native/scanlines.h): a darkened band in the last third of every
+// source row, drawn over the scaled picture, never into it; nothing below twice the rows (the gaps could not be resolved).
+static uint64 rrScanlineCoverage(uint64 position, uint64 height) {
+	uint64 remainder = position % (3 * height);
+	return position / (3 * height) * height + (remainder > 2 * height ? remainder - 2 * height : 0);
+}
+
+static uint8 rrScanlineAlpha(int y, int height, int sourceRows) {
+	if (sourceRows <= 0 || height <= 0 || y < 0 || y >= height || (uint64)height < 2 * (uint64)sourceRows)
+		return 0;
+	const uint64 step = 3 * (uint64)sourceRows;
+	const uint64 begin = rrScanlineCoverage((uint64)y * step, (uint64)height);
+	const uint64 end = rrScanlineCoverage((uint64)(y + 1) * step, (uint64)height);
+	return (uint8)((85 * (end - begin) + step / 2) / step);
+}
+
+static void rrDrawScanlines(SDL_Renderer *renderer, const SDL_Rect &view, int sourceRows) {
+	SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_BLEND);
+	int runStart = 0;
+	uint8 runAlpha = rrScanlineAlpha(0, view.h, sourceRows);
+	for (int y = 1; y <= view.h; y++) {
+		const uint8 alpha = y < view.h ? rrScanlineAlpha(y, view.h, sourceRows) : 255;
+		if (alpha == runAlpha)
+			continue;
+		if (runAlpha) {
+			SDL_Rect band = {view.x, view.y + runStart, view.w, y - runStart};
+			SDL_SetRenderDrawColor(renderer, 0, 0, 0, runAlpha);
+			SDL_RenderFillRect(renderer, &band);
+		}
+		runStart = y;
+		runAlpha = alpha;
+	}
+}
+#endif
