+void RetroRecompOptionsWidget::load() {
+	testNote("Retro-Recomp options page: load\n");
+	// The language of the menus is the same key as ScummVM's own "GUI language".
+	const Common::String language = ConfMan.get("gui_language");
+	_languageAtLoad = 0;
+	for (uint i = 0; i < ARRAYSIZE(kLanguages); i++) {
+		if (language.hasPrefixIgnoreCase(kLanguages[i].code) ||
+		    (i > 0 && language.hasPrefixIgnoreCase(Common::String(kLanguages[i].code).substr(0, 2))))
+			_languageAtLoad = i;
+	}
+	_languagePopUp->setSelectedTag(_languageAtLoad);
+
+	_fullscreenAtLoad = ConfMan.getBool("fullscreen");
+	_fullscreen->setState(_fullscreenAtLoad);
+
+	_scaleAtLoad = g_system->getDefaultStretchMode();
+	const Common::String stretch = ConfMan.get("stretch_mode");
+	for (const OSystem::GraphicsMode *mode = g_system->getSupportedStretchModes(); mode && mode->name; mode++) {
+		if (stretch.equalsIgnoreCase(mode->name))
+			_scaleAtLoad = mode->id;
+	}
+	_scalePopUp->setSelectedTag(_scaleAtLoad);
+
+	_aspectAtLoad = ConfMan.getBool("aspect_ratio");
+	_aspect->setState(_aspectAtLoad);
+
+	_musicAtLoad = ConfMan.getInt("music_volume");
+	_effectsAtLoad = ConfMan.getInt("sfx_volume");
+	_speechAtLoad = ConfMan.getInt("speech_volume");
+	_music->setValue(_musicAtLoad);
+	_effects->setValue(_effectsAtLoad);
+	_speech->setValue(_speechAtLoad);
+	_musicValue->setLabel(Common::U32String::format("%d", _musicAtLoad));
+	_effectsValue->setLabel(Common::U32String::format("%d", _effectsAtLoad));
+	_speechValue->setLabel(Common::U32String::format("%d", _speechAtLoad));
+
+	_muteAtLoad = ConfMan.getBool("mute");
+	_mute->setState(_muteAtLoad);
+}
+
+// The keys go to the application domain; a copy of the same key in the game's domain would hide it, so it is removed.
+void RetroRecompOptionsWidget::setKey(const char *key, const Common::String &value) {
+	ConfMan.set(key, value, Common::ConfigManager::kApplicationDomain);
+	if (!_domain.empty() && ConfMan.hasGameDomain(_domain) && ConfMan.hasKey(key, _domain))
+		ConfMan.removeKey(key, _domain);
+}
+
+void RetroRecompOptionsWidget::setBoolKey(const char *key, bool value) {
+	setKey(key, value ? "true" : "false");
+}
+
+void RetroRecompOptionsWidget::setIntKey(const char *key, int value) {
+	setKey(key, Common::String::format("%d", value));
+}
+
+bool RetroRecompOptionsWidget::save() {
+	testNote("Retro-Recomp options page: save\n");
+	bool changed = false;
+	bool graphics = false;
+
+	const int language = (int)_languagePopUp->getSelectedTag();
+	if (language != _languageAtLoad && language >= 0 && language < (int)ARRAYSIZE(kLanguages)) {
+		setKey("gui_language", kLanguages[language].code);      // read again at the next start
+		changed = true;
+	}
+	if (_fullscreen->getState() != _fullscreenAtLoad) {
+		setBoolKey("fullscreen", _fullscreen->getState());
+		changed = graphics = true;
+	}
+	const int scale = (int)_scalePopUp->getSelectedTag();
+	if (scale != _scaleAtLoad) {
+		for (const OSystem::GraphicsMode *mode = g_system->getSupportedStretchModes(); mode && mode->name; mode++) {
+			if (mode->id == scale)
+				setKey("stretch_mode", mode->name);
+		}
+		changed = graphics = true;
+	}
+	if (_aspect->getState() != _aspectAtLoad) {
+		setBoolKey("aspect_ratio", _aspect->getState());
+		changed = graphics = true;
+	}
+	if (_music->getValue() != _musicAtLoad) {
+		setIntKey("music_volume", _music->getValue());
+		changed = true;
+	}
+	if (_effects->getValue() != _effectsAtLoad) {
+		setIntKey("sfx_volume", _effects->getValue());
+		changed = true;
+	}
+	if (_speech->getValue() != _speechAtLoad) {
+		setIntKey("speech_volume", _speech->getValue());
+		changed = true;
+	}
+	if (_mute->getState() != _muteAtLoad) {
+		setBoolKey("mute", _mute->getState());
+		changed = true;
+	}
+
+	if (graphics) {
+		// The same transaction as the launcher's graphics options.
+		g_system->beginGFXTransaction();
+		g_system->setStretchMode(ConfMan.get("stretch_mode").c_str());
+		if (ConfMan.hasKey("aspect_ratio"))
+			g_system->setFeatureState(OSystem::kFeatureAspectRatioCorrection, ConfMan.getBool("aspect_ratio"));
+		if (ConfMan.hasKey("fullscreen"))
+			g_system->setFeatureState(OSystem::kFeatureFullscreenMode, ConfMan.getBool("fullscreen"));
+		g_system->endGFXTransaction();
+	}
+	return changed;
+}
