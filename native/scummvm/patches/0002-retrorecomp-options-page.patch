+void RetroRecompOptionsWidget::handleCommand(GUI::CommandSender *sender, uint32 cmd, uint32 data) {
+	if (cmd == kMusicCmd || cmd == kEffectsCmd || cmd == kSpeechCmd) {
+		GUI::StaticTextWidget *value = cmd == kMusicCmd ? _musicValue : cmd == kEffectsCmd ? _effectsValue : _speechValue;
+		value->setLabel(Common::U32String::format("%d", (int)data));
+		return;
+	}
+	if (cmd == kKeysCmd) {
+		if (GUI::ConfigDialog *dialog = dynamic_cast<GUI::ConfigDialog *>(_parentDialog))
+			dialog->showKeymapsTab();
+		return;
+	}
+	OptionsContainerWidget::handleCommand(sender, cmd, data);
+}
