+// ---------------------------------------------------------------------------------------------
+// Settings shared by the adventure executables of a folder: datas/Retro-Recomp.ini, section
+// [Adventure], holds ScummVM's own keys. They are applied to the game's scummvm.ini at the start
+// and copied back from it once the run is over (packedSyncSettings).
+
+namespace {
+
+const char *const kSharedKeys[] = {"fullscreen", "stretch_mode", "aspect_ratio", "music_volume", "sfx_volume", "speech_volume", "mute",
+                                   "scaler", "scale_factor", "rr_scanlines"};
+
+Common::String g_commonIni, g_gameIni;
+
+// Sets `key` in every section of the text that has it, and in [scummvm] (the application domain) in any case.
+Common::String forceIniValue(const Common::String &text, const char *key, const Common::String &value) {
+	const Common::Array<Common::String> lines = textLines(text);
+	const Common::String prefix = Common::String(key) + "=";
+	Common::String out;
+	for (uint i = 0; i < lines.size(); i++) {
+		out += (lines[i].hasPrefix(prefix) ? prefix + value : lines[i]) + "\n";
+	}
+	return setIniValue(out, "scummvm", key, value.c_str());
+}
+
+// The value ScummVM would use: the game's own section when it has the key, else [scummvm].
+Common::String effectiveIniValue(const Common::String &text, const char *key) {
+	const Common::Array<Common::String> lines = textLines(text);
+	const Common::String prefix = Common::String(key) + "=";
+	Common::String application, game;
+	bool inApplication = false, inGame = false;
+	for (uint i = 0; i < lines.size(); i++) {
+		if (!lines[i].empty() && lines[i][0] == '[') {
+			inApplication = lines[i].equalsIgnoreCase("[scummvm]");
+			inGame = !inApplication && !lines[i].equalsIgnoreCase("[keymapper]") && !lines[i].equalsIgnoreCase("[cloud]");
+		} else if (lines[i].hasPrefix(prefix)) {
+			if (inApplication)
+				application = lines[i].substr(prefix.size());
+			else if (inGame)
+				game = lines[i].substr(prefix.size());
+		}
+	}
+	return game.empty() ? application : game;
+}
+
+const char *languageOfGuiCode(const Common::String &code) {
+	if (code.hasPrefixIgnoreCase("fr"))
+		return "fr";
+	if (code.hasPrefixIgnoreCase("de"))
+		return "de";
+	if (code.hasPrefixIgnoreCase("es"))
+		return "es";
+	if (code.hasPrefixIgnoreCase("it"))
+		return "it";
+	return "en";
+}
+
+} // namespace
+
+void packedSyncSettings() {
+	if (!g_pack.present || g_commonIni.empty() || g_gameIni.empty())
+		return;
+	const Common::String game = readTextFile(g_gameIni);
+	if (game.empty())
+		return;
+	Common::String common = readTextFile(g_commonIni);
+	const Common::String before = common;
+	for (uint i = 0; i < ARRAYSIZE(kSharedKeys); i++) {
+		const Common::String value = effectiveIniValue(game, kSharedKeys[i]);
+		if (!value.empty() && iniValue(common, "Adventure", kSharedKeys[i]) != value)
+			common = setIniValue(common, "Adventure", kSharedKeys[i], value.c_str());
+	}
+	// The menu language: ScummVM's "gui_language" back to the language code of Retro-Recomp.ini.
+	const Common::String code = effectiveIniValue(game, "gui_language");
+	if (!code.empty()) {
+		const char *language = languageOfGuiCode(code);
+		if (iniValue(common, "Interface", "language") != language)
+			common = setIniValue(common, "Interface", "language", language);
+	}
+	if (common != before)
+		writeTextFile(g_commonIni, common);
+}
