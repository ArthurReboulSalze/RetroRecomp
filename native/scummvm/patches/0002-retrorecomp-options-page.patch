+void pushKey(Common::KeyCode code, int ascii, byte flags = 0) {
+	Common::Event down;
+	down.type = Common::EVENT_KEYDOWN;
+	down.kbd.keycode = code;
+	down.kbd.ascii = ascii;
+	down.kbd.flags = flags;
+	g_system->getEventManager()->pushEvent(down);
+	Common::Event up = down;
+	up.type = Common::EVENT_KEYUP;
+	g_system->getEventManager()->pushEvent(up);
+}
+
+// The hint of the menu key, once, a few seconds after the start (the timer runs on its own thread; the message queue is thread safe).
+int g_hintTicks = 0;
+
+void hintDriver(void *) {
+	if (++g_hintTicks == 1)
+		Common::OSDMessageQueue::instance().addMessage(retroRecompMenuHint());
+}
+
+// Authored checks with the real dialogs (RR_TEST_SCRIPT = a text file): one line per step, one step per tick.
+//   wait   (one idle tick)      menu      key esc | key o      click X Y | rclick X Y      shot      quit
+Common::Array<Common::String> g_script;
+uint g_scriptPos = 0;
+
+void pushMouse(Common::EventType type, int x, int y) {
+	Common::Event event;
+	event.type = type;
+	event.mouse = Common::Point(x, y);
+	g_system->getEventManager()->pushEvent(event);
+}
+
+void scriptKey(const Common::String &combo) {
+	byte flags = 0;
+	Common::String name = combo;
+	for (;;) {
+		const int plus = name.find('+');
+		if (plus < 0)
+			break;
+		const Common::String part = name.substr(0, plus);
+		if (part == "ctrl")
+			flags |= Common::KBD_CTRL;
+		else if (part == "alt")
+			flags |= Common::KBD_ALT;
+		else if (part == "shift")
+			flags |= Common::KBD_SHIFT;
+		name = name.substr(plus + 1);
+	}
+	Common::KeyCode code = Common::KEYCODE_INVALID;
+	int ascii = 0;
+	if (name == "esc") {
+		code = Common::KEYCODE_ESCAPE;
+		ascii = Common::ASCII_ESCAPE;
+	} else if (name == "enter") {
+		code = Common::KEYCODE_RETURN;
+		ascii = Common::ASCII_RETURN;
+	} else if (name == "f5") {
+		code = Common::KEYCODE_F5;
+		ascii = Common::ASCII_F5;
+	} else if (name.size() == 1 && name[0] >= 'a' && name[0] <= 'z') {
+		code = (Common::KeyCode)(Common::KEYCODE_a + (name[0] - 'a'));
+		ascii = name[0];
+	}
+	if (code == Common::KEYCODE_INVALID)
+		return;
+	Common::Event down;
+	down.type = Common::EVENT_KEYDOWN;
+	down.kbd.keycode = code;
+	down.kbd.ascii = ascii;
+	down.kbd.flags = flags;
+	g_system->getEventManager()->pushEvent(down);
+	Common::Event up = down;
+	up.type = Common::EVENT_KEYUP;
+	g_system->getEventManager()->pushEvent(up);
+}
+
+void scriptDriver(void *) {
+	if (g_scriptPos >= g_script.size())
+		return;
+	const Common::String line = g_script[g_scriptPos++];
+	int x = 0, y = 0;
+	if (line.hasPrefix("key "))
+		scriptKey(line.substr(4));
+	else if (sscanf(line.c_str(), "click %d %d", &x, &y) == 2 || sscanf(line.c_str(), "rclick %d %d", &x, &y) == 2) {
+		const bool right = line.hasPrefix("rclick");
+		pushMouse(Common::EVENT_MOUSEMOVE, x, y);
+		pushMouse(right ? Common::EVENT_RBUTTONDOWN : Common::EVENT_LBUTTONDOWN, x, y);
+		pushMouse(right ? Common::EVENT_RBUTTONUP : Common::EVENT_LBUTTONUP, x, y);
+	} else if (line == "menu") {
+		Common::Event menu;                     // what the keymapper turns Ctrl+F5 into (pushed events do not pass through it)
+		menu.type = Common::EVENT_MAINMENU;
+		g_system->getEventManager()->pushEvent(menu);
+	} else if (line == "shot")
+		g_system->saveScreenshot();
+	else if (line == "quit") {
+		Common::Event quit;
+		quit.type = Common::EVENT_QUIT;
+		g_system->getEventManager()->pushEvent(quit);
+	}
+}
+
+void optionsDriver(void *) {
+	g_optionsStep++;
+	if (g_optionsStep == 1) {
+		Common::Event menu;
+		menu.type = Common::EVENT_MAINMENU;
+		g_system->getEventManager()->pushEvent(menu);
+	} else if (g_optionsStep == 3) {
+		pushKey(Common::KEYCODE_o, 'o');        // ~O~ptions
+	} else if (g_optionsStep == 5) {
+		g_system->saveScreenshot();             // a screenshot of the page (to the "screenshotpath" of the test)
+	} else if (g_optionsStep == 7) {
+		pushKey(Common::KEYCODE_o, 'o');        // ~O~K
+	} else if (g_optionsStep == 9) {
+		Common::Event quit;                     // the run ends by itself: no launcher, exit code 0, settings synced
+		quit.type = Common::EVENT_QUIT;
+		g_system->getEventManager()->pushEvent(quit);
+	}
+}
+
+} // namespace
