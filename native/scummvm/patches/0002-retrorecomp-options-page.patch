+// --- Ctrl+F1 and Ctrl+F2: the options dialog straight on the Help or the Retro-Recomp tab -------------------------------------------
+
+namespace {
+
+int g_requestedTab = -1;
+uint32 g_requestedAt = 0;
+
+} // namespace
+
+// The keys push EVENT_MAINMENU (what the engines already handle); Engine::openMainMenuDialog then finds the request and opens the
+// options dialog instead of the menu. A request older than a second and a half is stale and ignored.
+void retroRecompRequestOptions(int tab) {
+	g_requestedTab = tab;
+	g_requestedAt = g_system->getMillis(true);
+	Common::Event event;
+	event.type = Common::EVENT_MAINMENU;
+	g_system->getEventManager()->pushEvent(event);
+}
+
+bool retroRecompTakeOptionsRequest(int &tab) {
+	const bool fresh = g_requestedTab >= 0 && g_system->getMillis(true) - g_requestedAt < 1500;
+	tab = g_requestedTab;
+	g_requestedTab = -1;
+	return fresh;
+}
