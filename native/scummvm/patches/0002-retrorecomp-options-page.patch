+namespace {
+
+// The picture effects of the host kit's F3 (sharp pixels, a smoothing filter, Scale2x, scanlines) with ScummVM's software scalers
+// (normal, HQ2x, AdvMAME / Scale2x) and, for the scanlines, the host kit's mask drawn over the scaled picture. All at factor 2.
+struct Effect {
+	const char *scaler;
+	Text name;
+	bool scanlines;       // the host kit's scanline mask is drawn over the scaled picture (backends/graphics/surfacesdl)
+};
+
+const Effect kPictureEffects[] = {
+	{"normal",  {"Sharp pixels", "Pixels nets", "Scharfe Pixel", "P\xC3\xADxeles n\xC3\xADtidos", "Pixel nitidi"}, false},
+	{"hq",      {"HQ2x", "HQ2x", "HQ2x", "HQ2x", "HQ2x"}, false},
+	{"advmame", {"Scale2x", "Scale2x", "Scale2x", "Scale2x", "Scale2x"}, false},
+	{"normal",  {"Scanlines", "Lignes de balayage", "Scanlines", "L\xC3\xADneas de barrido", "Scanline"}, true}
+};
+
+Common::U32String pick(const Text &t) {
+	const Common::String language = ConfMan.get("gui_language");
+	const char *chosen = t.en;
+	if (language.hasPrefixIgnoreCase("fr"))
+		chosen = t.fr;
+	else if (language.hasPrefixIgnoreCase("de"))
+		chosen = t.de;
+	else if (language.hasPrefixIgnoreCase("es"))
+		chosen = t.es;
+	else if (language.hasPrefixIgnoreCase("it"))
+		chosen = t.it;
+	return Common::U32String(chosen);
+}
+
+// The keys go to the application domain; a copy in the game's domain would hide them.
+void rememberKey(const char *key, const Common::String &value) {
+	ConfMan.set(key, value, Common::ConfigManager::kApplicationDomain);
+	const Common::String game = ConfMan.getActiveDomainName();
+	if (!game.empty() && ConfMan.hasGameDomain(game) && ConfMan.hasKey(key, game))
+		ConfMan.removeKey(key, game);
+}
+
+Common::String stretchName(int id) {
+	for (const OSystem::GraphicsMode *mode = g_system->getSupportedStretchModes(); mode && mode->name; mode++) {
+		if (mode->id == id)
+			return mode->name;
+	}
+	return Common::String();
+}
+
