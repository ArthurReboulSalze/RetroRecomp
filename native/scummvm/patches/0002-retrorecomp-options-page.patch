+// One tick a second, from the first poll of the engine (the game's own picture is up by then). A message stays on screen about
+// two seconds, so the hint is repeated every second for three seconds, once.
+void hintTick() {
+	if (++g_hintTicks == 1)
+		g_hintBurst = 3;
