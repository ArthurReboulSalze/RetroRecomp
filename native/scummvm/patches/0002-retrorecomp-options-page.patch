+
+void retroRecompNextEffect() {
+	if (!g_system->hasFeature(OSystem::kFeatureScalers))
+		return;
+	const Common::String current = ConfMan.get("scaler");
+	uint index = 0;
+	if (ConfMan.hasKey("rr_scanlines") && ConfMan.getBool("rr_scanlines")) {
+		index = 3;
+	} else {
+		for (uint i = 0; i < 3; i++) {
+			if (current.equalsIgnoreCase(kPictureEffects[i].scaler))
+				index = i;
+		}
+	}
+	index = (index + 1) % ARRAYSIZE(kPictureEffects);
+
+	g_system->beginGFXTransaction();
+	g_system->setScaler(kPictureEffects[index].scaler, 2);
+	g_system->endGFXTransaction();
+	packedSetScanlines(kPictureEffects[index].scanlines);
+	rememberKey("scaler", kPictureEffects[index].scaler);
+	rememberKey("scale_factor", "2");
+	rememberKey("rr_scanlines", kPictureEffects[index].scanlines ? "true" : "false");
+	ConfMan.flushToDisk();                       // ScummVM writes its settings only when a dialog is confirmed
+	g_system->displayMessageOnOSD(text(kEffect) + Common::U32String(" ") + pick(kPictureEffects[index].name));
+}
+
+void retroRecompTogglePixelPerfect() {
+	static bool savedFullscreen = false;
+	static Common::String savedStretch;
+	const bool fullscreen = g_system->getFeatureState(OSystem::kFeatureFullscreenMode);
+	const Common::String stretch = stretchName(g_system->getStretchMode());
+	const bool active = fullscreen && stretch == "pixel-perfect";
+
+	bool wantFullscreen;
+	Common::String wantStretch;
+	if (active) {
+		wantFullscreen = savedFullscreen;
+		wantStretch = savedStretch.empty() ? Common::String("fit") : savedStretch;
+	} else {
+		savedFullscreen = fullscreen;
+		savedStretch = stretch;
+		wantFullscreen = true;
+		wantStretch = "pixel-perfect";
+	}
+	g_system->beginGFXTransaction();
+	g_system->setStretchMode(wantStretch.c_str());
+	g_system->setFeatureState(OSystem::kFeatureFullscreenMode, wantFullscreen);
+	g_system->endGFXTransaction();
+	rememberKey("fullscreen", wantFullscreen ? "true" : "false");
+	rememberKey("stretch_mode", wantStretch);
+	ConfMan.flushToDisk();
+	g_system->displayMessageOnOSD(text(active ? kPixelOff : kPixelOn));
+}
