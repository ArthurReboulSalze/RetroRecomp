+
+struct PackEntry {
+	Common::String path;   // relative, '/' separated, no leading separator
+	uint64 offset;
+	uint64 size;
+};
+
+/** The index of the pack, read once from the end of the executable. */
+class Pack {
+public:
+	Common::String exePath;
+	Common::Array<PackEntry> files;
+	bool loaded = false;
+	bool present = false;
+
+	void load(FilesystemFactory *real);
+};
+
+Pack g_pack;
+
+Common::String executablePath() {
+#if defined(WIN32)
+	char buffer[MAX_PATH * 2];
+	DWORD n = GetModuleFileNameA(nullptr, buffer, sizeof(buffer));
+	if (n == 0 || n >= sizeof(buffer))
+		return Common::String();
+	return Common::String(buffer, n);
+#else
+	char buffer[PATH_MAX];
+	ssize_t n = readlink("/proc/self/exe", buffer, sizeof(buffer) - 1);
+	if (n <= 0)
+		return Common::String();
+	return Common::String(buffer, n);
+#endif
+}
+
+void Pack::load(FilesystemFactory *real) {
+	if (loaded)
+		return;
+	loaded = true;
+
+	exePath = executablePath();
+	if (exePath.empty())
+		return;
+
+	AbstractFSNode *node = real->makeFileNodePath(exePath);
+	Common::SeekableReadStream *in = node ? node->createReadStream() : nullptr;
+	delete node;
+	if (!in)
+		return;
+
+	const int64 total = in->size();
+	if (total < 24 || !in->seek(total - 24, SEEK_SET)) {
+		delete in;
+		return;
+	}
+	char magic[8];
+	in->read(magic, 8);
+	const uint64 indexOffset = in->readUint64LE();
+	const uint64 indexSize = in->readUint64LE();
+	if (memcmp(magic, "RRADVPK1", 8) != 0 || indexOffset + indexSize + 24 > (uint64)total) {
+		delete in;
+		return;
+	}
+
+	in->seek((int64)indexOffset, SEEK_SET);
+	const uint64 end = indexOffset + indexSize;
+	while ((uint64)in->pos() < end && !in->eos()) {
+		const uint16 length = in->readUint16LE();
+		Common::String path;
+		for (uint16 i = 0; i < length; i++)
+			path += (char)in->readByte();
+		PackEntry entry;
+		entry.path = path;
+		entry.offset = in->readUint64LE();
+		entry.size = in->readUint64LE();
+		files.push_back(entry);
+	}
+	delete in;
+	present = !files.empty();
+}
+
+/** "pack:" followed by a separator, then the relative path with the native separator. */
+Common::String nodePath(const Common::String &rel) {
+	Common::String out("pack:");
+	out += kNativeSep;
+	for (uint i = 0; i < rel.size(); i++)
+		out += (rel[i] == '/') ? kNativeSep : rel[i];
+	return out;
+}
+
+/** Relative path of a "pack:..." path, normalised to '/' with no leading or trailing separator. */
+Common::String relativeOf(const Common::String &path) {
+	Common::String rel;
+	for (uint i = 5; i < path.size(); i++) {   // skip "pack:"
+		char c = path[i] == '\\' ? '/' : path[i];
+		if (c == '/' && (rel.empty() || rel.lastChar() == '/'))
+			continue;
+		rel += c;
+	}
+	while (!rel.empty() && rel.lastChar() == '/')
+		rel.deleteLastChar();
+	return rel;
+}
+
+/**
+ * One file of the pack, read through its own handle on the executable. It behaves like a
+ * file on disk: a seek to a negative position fails and leaves the position unchanged, a
+ * seek past the end succeeds and the next read reports the end of the stream. (The common
+ * sub-stream classes assert instead, which is why they are not used here.) Positions are
+ * 64-bit, so packs larger than 4 GB are not a problem.
+ */
+class PackedReadStream final : public Common::SeekableReadStream {
+public:
+	PackedReadStream(Common::SeekableReadStream *parent, uint64 begin, uint64 size)
+		: _parent(parent), _begin(begin), _size(size), _pos(0), _eos(false) {}
+	~PackedReadStream() override { delete _parent; }
+
+	bool err() const override { return _parent->err(); }
+	void clearErr() override { _eos = false; _parent->clearErr(); }
+	bool eos() const override { return _eos; }
+	int64 pos() const override { return (int64)_pos; }
+	int64 size() const override { return (int64)_size; }
+
+	bool seek(int64 offset, int whence = SEEK_SET) override {
+		int64 target;
+		switch (whence) {
+		case SEEK_END:
+			target = (int64)_size + offset;
+			break;
+		case SEEK_CUR:
+			target = (int64)_pos + offset;
+			break;
+		default:
+			target = offset;
+			break;
+		}
+		if (target < 0)
+			return false;
+		_pos = (uint64)target;
+		_eos = false;
+		return true;
+	}
+
+	uint32 read(void *dataPtr, uint32 dataSize) override {
+		if (_pos >= _size) {
+			_eos = true;
+			return 0;
+		}
+		const uint64 left = _size - _pos;
+		if ((uint64)dataSize > left) {
+			dataSize = (uint32)left;
+			_eos = true;
+		}
+		const int64 where = (int64)(_begin + _pos);
+		if (_parent->pos() != where && !_parent->seek(where, SEEK_SET))
+			return 0;
+		const uint32 got = _parent->read(dataPtr, dataSize);
+		_pos += got;
+		return got;
+	}
+
+private:
+	Common::SeekableReadStream *_parent;
+	uint64 _begin, _size, _pos;
+	bool _eos;
+};
+
+class PackedNode final : public AbstractFSNode {
+public:
+	PackedNode(const Common::String &rel) : _rel(rel), _entry(-1), _dir(false), _exists(false) {
+		resolve();
+	}
+
+	bool exists() const override { return _exists; }
+	Common::U32String getDisplayName() const override { return Common::U32String(getName()); }
+	Common::String getName() const override {
+		if (_rel.empty())
+			return "pack:";
+		const size_t slash = _rel.rfind('/');
+		return slash == Common::String::npos ? _rel : _rel.substr(slash + 1);
+	}
+	Common::String getPath() const override { return nodePath(_rel); }
+	bool isDirectory() const override { return _dir; }
+	bool isReadable() const override { return _exists; }
+	bool isWritable() const override { return false; }
+
+	AbstractFSNode *getChild(const Common::String &name) const override {
+		if (!_dir)
+			return nullptr;
+		return new PackedNode(_rel.empty() ? name : _rel + "/" + name);
+	}
+
+	bool getChildren(AbstractFSList &list, ListMode mode, bool hidden) const override {
+		if (!_dir)
+			return false;
+		const Common::String prefix = _rel.empty() ? Common::String() : _rel + "/";
+		Common::Array<Common::String> dirs;
+		for (uint i = 0; i < g_pack.files.size(); i++) {
+			const Common::String &p = g_pack.files[i].path;
+			if (p.hasPrefixIgnoreCase(".rr/"))
+				continue;
+			if (!prefix.empty() && !p.hasPrefixIgnoreCase(prefix))
+				continue;
+			const Common::String rest = p.substr(prefix.size());
+			const size_t slash = rest.find('/');
+			if (slash == Common::String::npos) {
+				if (mode != Common::FSNode::kListDirectoriesOnly)
+					list.push_back(new PackedNode(p));
+			} else if (mode != Common::FSNode::kListFilesOnly) {
+				const Common::String dir = rest.substr(0, slash);
+				bool known = false;
+				for (uint k = 0; k < dirs.size(); k++)
+					known = known || dirs[k].equalsIgnoreCase(dir);
+				if (!known) {
+					dirs.push_back(dir);
+					list.push_back(new PackedNode(prefix + dir));
+				}
+			}
+		}
+		return true;
+	}
+
+	AbstractFSNode *getParent() const override {
+		if (_rel.empty())
+			return new PackedNode(_rel);
+		const size_t slash = _rel.rfind('/');
+		return new PackedNode(slash == Common::String::npos ? Common::String() : _rel.substr(0, slash));
+	}
+
+	Common::SeekableReadStream *createReadStream() override {
+		if (_entry < 0)
+			return nullptr;
+		AbstractFSNode *node = g_pack_real->makeFileNodePath(g_pack.exePath);
+		Common::SeekableReadStream *parent = node ? node->createReadStream() : nullptr;
+		delete node;
+		if (!parent)
+			return nullptr;
+		const PackEntry &e = g_pack.files[_entry];
+		return new PackedReadStream(parent, e.offset, e.size);
+	}
+
+	Common::SeekableWriteStream *createWriteStream(bool) override { return nullptr; }
+	bool createDirectory() override { return false; }
+
+	static FilesystemFactory *g_pack_real;
+
+private:
+	void resolve() {
+		if (_rel.empty()) {
+			_dir = _exists = true;
+			return;
+		}
+		const Common::String prefix = _rel + "/";
+		for (uint i = 0; i < g_pack.files.size(); i++) {
+			const Common::String &p = g_pack.files[i].path;
+			if (p.hasPrefixIgnoreCase(".rr/"))
+				continue;
+			if (p.equalsIgnoreCase(_rel)) {
+				_entry = (int)i;
+				_exists = true;
+				_rel = p;   // the stored spelling
+				return;
+			}
+			if (p.hasPrefixIgnoreCase(prefix)) {
+				_dir = _exists = true;
+				_rel = p.substr(0, _rel.size());
+				return;
+			}
+		}
+	}
+
+	Common::String _rel;
+	int _entry;
+	bool _dir;
+	bool _exists;
+};
+
+FilesystemFactory *PackedNode::g_pack_real = nullptr;
+
