+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ *
+ */
+
+/* Retro-Recomp patch (step 1 prototype): a read-only virtual file system whose
+ * files are stored, byte for byte, at the end of the executable itself.
+ *
+ * Layout of the executable: [original program][file data...][index][trailer]
+ * Trailer (24 bytes, little endian): "RRADVPK1", index offset (u64), index size (u64).
+ * Index: for each file, u16 path length, the path (UTF-8, '/' separated, no leading
+ * separator), u64 offset of the data in the executable, u64 size.
+ *
+ * Paths that start with "pack:" are served from the pack; every other path goes to
+ * the real file system of the platform. Nothing is ever extracted.
+ */
+
+#ifndef BACKEND_FS_PACKED_H
+#define BACKEND_FS_PACKED_H
+
+#include "backends/fs/fs-factory.h"
+
+class PackedFilesystemFactory final : public FilesystemFactory {
+public:
+	/** Takes ownership of @p real, the factory of the platform. */
+	explicit PackedFilesystemFactory(FilesystemFactory *real);
+	~PackedFilesystemFactory() override;
+
+	AbstractFSNode *makeRootFileNode() const override;
+	AbstractFSNode *makeCurrentDirectoryFileNode() const override;
+	AbstractFSNode *makeFileNodePath(const Common::String &path) const override;
+	Common::String getSystemFullPath(const Common::String &path) const override;
+
+private:
+	FilesystemFactory *_real;
+};
+
+/**
+ * When this executable carries a game and was started without arguments, replaces
+ * the argument list by the one that runs that game: the path of the pack, and the
+ * configuration, saves and log inside datas/games/<Game>-<id>/ next to the executable
+ * (created on first use, with datas/Retro-Recomp.ini). Does nothing otherwise.
+ */
+void packedLaunchArguments(int &argc, char **&argv);
+
+/** True when this executable carries a game: the platform then creates no folder of its own outside datas/. */
+bool packedModeActive();
+
+/** Authored checks of the pack streams (negative and end-relative seeks); 0 when all pass. */
+int packedSelfTest();
+
+#endif
