+AbstractFSNode *PackedFilesystemFactory::makeFileNodePath(const Common::String &path) const {
+	if (g_pack.present && path.hasPrefixIgnoreCase("pack:"))
+		return new PackedNode(relativeOf(path));
+	return _real->makeFileNodePath(path);
+}
