+// ---------------------------------------------------------------------------------------------
+// Authored self-test of the pack streams (no game data): the packer stores ".rr/selftest.bin",
+// the 256 bytes 0..255; RR_PACK_SELFTEST=1 runs these checks and exits with their result.
+
+int packedSelfTest() {
+	int index = -1;
+	for (uint i = 0; i < g_pack.files.size(); i++)
+		if (g_pack.files[i].path.equalsIgnoreCase(".rr/selftest.bin"))
+			index = (int)i;
+	if (index < 0) {
+		fprintf(stderr, "selftest: no .rr/selftest.bin in this pack\n");
+		return 2;
+	}
+	AbstractFSNode *node = PackedNode::g_pack_real->makeFileNodePath(g_pack.exePath);
+	Common::SeekableReadStream *parent = node ? node->createReadStream() : nullptr;
+	delete node;
+	if (!parent)
+		return 2;
+	PackedReadStream s(parent, g_pack.files[index].offset, g_pack.files[index].size);
+	int failures = 0;
+	byte b[16];
+#define RR_CHECK(cond, what) do { bool ok_ = (cond); fprintf(stderr, "selftest %s: %s\n", ok_ ? "ok  " : "FAIL", what); if (!ok_) failures++; } while (0)
+	RR_CHECK(s.size() == 256, "size is 256");
+	RR_CHECK(s.seek(10, SEEK_SET) && s.pos() == 10, "seek 10 from start");
+	RR_CHECK(!s.seek(-1, SEEK_SET) && s.pos() == 10, "seek -1 from start fails, position kept");
+	RR_CHECK(!s.seek(-11, SEEK_CUR) && s.pos() == 10, "seek -11 from current fails, position kept");
+	RR_CHECK(s.seek(-10, SEEK_CUR) && s.pos() == 0, "seek -10 from current reaches 0");
+	RR_CHECK(!s.seek(-257, SEEK_END) && s.pos() == 0, "seek -257 from end fails");
+	RR_CHECK(s.seek(-10, SEEK_END) && s.pos() == 246, "seek -10 from end gives 246");
+	RR_CHECK(s.read(b, 10) == 10 && b[0] == 246 && b[9] == 255 && !s.eos(), "read the last 10 bytes, no end yet");
+	RR_CHECK(s.read(b, 1) == 0 && s.eos(), "one more byte: end of stream");
+	RR_CHECK(s.seek(0, SEEK_SET) && !s.eos() && s.read(b, 4) == 4 && b[0] == 0 && b[3] == 3, "back to 0 clears the end, reads 0..3");
+	RR_CHECK(s.seek(-2, SEEK_END) && s.read(b, 8) == 2 && b[0] == 254 && b[1] == 255 && s.eos(), "short read at the end");
+	RR_CHECK(s.seek(1000, SEEK_SET) && s.pos() == 1000 && s.read(b, 1) == 0 && s.eos(), "seek past the end succeeds, read gives the end");
+	RR_CHECK(s.seek(128, SEEK_SET) && s.seek(-64, SEEK_CUR) && s.read(b, 1) == 1 && b[0] == 64, "relative seek backwards");
+#undef RR_CHECK
+	fprintf(stderr, "selftest: %d failure(s)\n", failures);
+	return failures == 0 ? 0 : 1;
+}
