+// ---------------------------------------------------------------------------------------------
+// Start-up without arguments: run the game that this executable carries.
+
+namespace {
+
+/** Contents of a file of the pack as text (empty when absent). */
+Common::String readPackText(const char *path) {
+	for (uint i = 0; i < g_pack.files.size(); i++) {
+		if (!g_pack.files[i].path.equalsIgnoreCase(path))
+			continue;
+		AbstractFSNode *node = PackedNode::g_pack_real->makeFileNodePath(g_pack.exePath);
+		Common::SeekableReadStream *parent = node ? node->createReadStream() : nullptr;
+		delete node;
+		if (!parent)
+			return Common::String();
+		const PackEntry &e = g_pack.files[i];
+		Common::String text;
+		if (e.size < 65536 && parent->seek((int64)e.offset, SEEK_SET)) {
+			for (uint64 k = 0; k < e.size; k++)
+				text += (char)parent->readByte();
+		}
+		delete parent;
+		return text;
+	}
+	return Common::String();
+}
+
+Common::String manifestValue(const Common::String &text, const char *key) {
+	const Common::String wanted = Common::String(key) + "=";
+	uint start = 0;
+	while (start < text.size()) {
+		size_t end = text.find('\n', start);
+		if (end == Common::String::npos)
+			end = text.size();
+		Common::String line = text.substr(start, end - start);
+		while (!line.empty() && (line.lastChar() == '\r' || line.lastChar() == ' '))
+			line.deleteLastChar();
+		if (line.hasPrefix(wanted))
+			return line.substr(wanted.size());
+		start = end + 1;
+	}
+	return Common::String();
+}
+
+bool makeDirectory(const Common::String &path) {
+#if defined(WIN32)
+	return CreateDirectoryA(path.c_str(), nullptr) != 0 || GetLastError() == ERROR_ALREADY_EXISTS;
+#else
+	return mkdir(path.c_str(), 0755) == 0 || errno == EEXIST;
+#endif
+}
+
+void makeDirectories(const Common::String &path) {
+	Common::String part;
+	for (uint i = 0; i < path.size(); i++) {
+		if ((path[i] == '/' || path[i] == '\\') && i > 2)
+			makeDirectory(part);
+		part += path[i];
+	}
+	makeDirectory(part);
+}
+
+Common::String readTextFile(const Common::String &path) {
+	Common::String text;
+	if (FILE *in = fopen(path.c_str(), "rb")) {
+		char buffer[4096];
+		size_t n;
+		while ((n = fread(buffer, 1, sizeof(buffer), in)) > 0)
+			text += Common::String(buffer, n);
+		fclose(in);
+	}
+	return text;
+}
+
+void writeTextFile(const Common::String &path, const Common::String &text) {
+	if (FILE *out = fopen(path.c_str(), "wb")) {
+		fwrite(text.c_str(), 1, text.size(), out);
+		fclose(out);
+	}
+}
+
+/** Lines of a text without their line ends. */
+Common::Array<Common::String> textLines(const Common::String &text) {
+	Common::Array<Common::String> lines;
+	Common::String line;
+	for (uint i = 0; i < text.size(); i++) {
+		if (text[i] == '\n') {
+			if (!line.empty() && line.lastChar() == '\r')
+				line.deleteLastChar();
+			lines.push_back(line);
+			line.clear();
+		} else {
+			line += text[i];
+		}
+	}
+	if (!line.empty())
+		lines.push_back(line);
+	return lines;
+}
+
+/** Value of key in [section] of an INI text (empty when absent). */
+Common::String iniValue(const Common::String &text, const char *section, const char *key) {
+	const Common::Array<Common::String> lines = textLines(text);
+	const Common::String header = Common::String("[") + section + "]";
+	const Common::String prefix = Common::String(key) + "=";
+	bool inside = false;
+	for (uint i = 0; i < lines.size(); i++) {
+		if (!lines[i].empty() && lines[i][0] == '[')
+			inside = lines[i].equalsIgnoreCase(header);
+		else if (inside && lines[i].hasPrefix(prefix))
+			return lines[i].substr(prefix.size());
+	}
+	return Common::String();
+}
+
+/** The INI text with key=value set in [section] (section and key added when missing). */
+Common::String setIniValue(const Common::String &text, const char *section, const char *key, const char *value) {
+	const Common::Array<Common::String> lines = textLines(text);
+	const Common::String header = Common::String("[") + section + "]";
+	const Common::String prefix = Common::String(key) + "=";
+	const Common::String wanted = prefix + value;
+	Common::Array<Common::String> out;
+	bool inside = false, done = false, seen = false;
+	for (uint i = 0; i < lines.size(); i++) {
+		const Common::String &l = lines[i];
+		if (!l.empty() && l[0] == '[') {
+			if (inside && !done) {
+				out.push_back(wanted);
+				done = true;
+			}
+			inside = l.equalsIgnoreCase(header);
+			seen = seen || inside;
+		} else if (inside && l.hasPrefix(prefix)) {
+			if (!done)
+				out.push_back(wanted);
+			done = true;
+			continue;
+		}
+		out.push_back(l);
+	}
+	if (inside && !done) {
+		out.push_back(wanted);
+		done = true;
+	}
+	if (!seen) {
+		out.insert_at(0, wanted);
+		out.insert_at(0, header);
+	}
+	Common::String result;
+	for (uint i = 0; i < out.size(); i++)
+		result += out[i] + "\n";
+	return result;
+}
+
+} // namespace
+
+void packedLaunchArguments(int &argc, char **&argv) {
+	if (!g_pack.present || argc != 1)
+		return;
+	const Common::String manifest = readPackText(".rr/launch.ini");
+	const Common::String target = manifestValue(manifest, "target");
+	if (target.empty())
+		return;
+	Common::String name = manifestValue(manifest, "name");
+	Common::String id = manifestValue(manifest, "id");
+	if (name.empty())
+		name = target;
+
+	Common::String exeDir = g_pack.exePath;
+	size_t cut = exeDir.rfind('\\');
+	if (cut == Common::String::npos)
+		cut = exeDir.rfind('/');
+	exeDir = cut == Common::String::npos ? Common::String(".") : exeDir.substr(0, cut);
+
+	const Common::String datas = exeDir + kNativeSep + "datas";
+	const Common::String gameDir = datas + kNativeSep + "games" + kNativeSep + name + (id.empty() ? Common::String() : "-" + id);
+	makeDirectories(gameDir + kNativeSep + "saves");
+
+	// datas/Retro-Recomp.ini with defaults, created once and never rewritten here.
+	const Common::String ini = datas + kNativeSep + "Retro-Recomp.ini";
+	if (FILE *probe = fopen(ini.c_str(), "rb")) {
+		fclose(probe);
+	} else if (FILE *out = fopen(ini.c_str(), "wb")) {
+		fputs("[Interface]\nlanguage=en\n[Adventure]\n", out);
+		fclose(out);
+	}
+
+	// The interface language of Retro-Recomp (one of the five game-menu languages) sets ScummVM's GUI
+	// language at every start; any other value, or none, gives English. The game's own language is
+	// never touched here: it comes from the data and the manifest.
+	const Common::String language = iniValue(readTextFile(ini), "Interface", "language");
+	const char *guiLanguage = "C";
+	if (language == "fr")
+		guiLanguage = "fr_FR";
+	else if (language == "de")
+		guiLanguage = "de_DE";
+	else if (language == "es")
+		guiLanguage = "es_ES";
+	else if (language == "it")
+		guiLanguage = "it_IT";
+	const Common::String config = gameDir + kNativeSep + "scummvm.ini";
+	writeTextFile(config, setIniValue(readTextFile(config), "scummvm", "gui_language", guiLanguage));
+
+	static Common::Array<Common::String> strings;
+	strings.clear();
+	strings.push_back(argv[0]);
+	strings.push_back(Common::String("--path=pack:") + kNativeSep);
+	strings.push_back("--config=" + config);
+	strings.push_back("--joystick=0");
+	strings.push_back("--savepath=" + gameDir + kNativeSep + "saves");
+	strings.push_back("--logfile=" + gameDir + kNativeSep + "scummvm.log");
+	strings.push_back(target);
+
+	static Common::Array<char *> pointers;
+	pointers.clear();
+	for (uint i = 0; i < strings.size(); i++)
+		pointers.push_back(const_cast<char *>(strings[i].c_str()));
+	pointers.push_back(nullptr);
+	argc = (int)strings.size();
+	argv = &pointers[0];
+}
